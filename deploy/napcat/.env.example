# NapCat Docker 进程使用的宿主机 UID/GID。
NAPCAT_UID=1000
NAPCAT_GID=1000

# 固定 NapCat/NTQQ 镜像版本；YawnBot 日常发布不会更新这个镜像。
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.19

# WebUI 只绑定宿主机 127.0.0.1；通过 SSH 隧道访问。
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=replace-with-a-random-napcat-webui-token

# 生产 bootstrap 会自动写成实际持久化目录；手工 Compose 可保留默认值。
NAPCAT_QQ_DIR=./data/QQ
NAPCAT_CONFIG_DIR=./data/config
NAPCAT_PLUGIN_DIR=./data/plugins
