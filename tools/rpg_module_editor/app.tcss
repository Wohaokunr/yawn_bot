/* 模组编辑器全局样式 */

Screen {
    background: $background;
}

Header {
    dock: top;
}

#editor-toolbar {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $panel;
    align-vertical: middle;
}

#editor-toolbar Button {
    min-width: 7;
    margin-right: 1;
}

#editor-toolbar .-toolbar-hint {
    width: 1fr;
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 2;
}

EditorTab {
    height: 1fr;
}

VerticalScroll {
    height: 1fr;
}

Label {
    height: auto;
}

Button {
    min-width: 8;
}

Footer {
    height: 1;
}
