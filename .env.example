# YawnBot 最小可运行配置
# 手工部署复制为 .env 后，至少修改 SUPERUSERS 与 ONEBOT_V11_ACCESS_TOKEN。
# OpenCloudOS 生产 bootstrap 会把 OneBot token 迁移/生成到 /opt/yawnbot/onebot.env。
# AI、Agent、WebUI、番茄、RPG/狼人杀高级参数见 docs/configuration/。

# ── NoneBot / HTTP ─────────────────────────────────────────────────────────────
ENVIRONMENT=prod
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# QQ 超级用户。必须是 JSON 字符串数组。
SUPERUSERS=["123456789"]

# ── OneBot V11 ─────────────────────────────────────────────────────────────────
# 默认使用反向 WebSocket：OneBot 实现连接 ws://HOST:PORT/onebot/v11/ws。
# 请换成独立、随机的 token，并在 NapCat/Lagrange 端填写相同值。
ONEBOT_V11_ACCESS_TOKEN=replace-with-a-random-onebot-token

# ── 数据 / ORM ─────────────────────────────────────────────────────────────────
# 固定到项目工作目录的 ./data；Docker Compose 会把 /app/data 持久化为 volume。
LOCALSTORE_USE_CWD=true
SQLALCHEMY_ENGINE_OPTIONS={"connect_args":{"timeout":30}}
ALEMBIC_CONTEXT={"compare_server_default":true}

# ── 无 AI Key 的安全默认 ───────────────────────────────────────────────────────
# 首次部署不要求配置模型服务。需要 AI 后再按 docs/configuration/ai-agent.md 开启。
RPG_AI_ENABLED=false
WW_AI_ENABLED=false
