# NoneBot runtime
ENVIRONMENT=prod
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=["123456789"]
SESSION_EXPIRE_TIMEOUT=00:02:00

# Store SQLite and other local data under ./data.
LOCALSTORE_USE_CWD=true
SQLALCHEMY_ENGINE_OPTIONS={"connect_args":{"timeout":30}}
ALEMBIC_CONTEXT={"compare_server_default":true}

# OneBot V11: choose one connection mode.
# Reverse WebSocket: configure the OneBot implementation to connect to
# ws://HOST:PORT/onebot/v11/ws and use the same token.
ONEBOT_V11_ACCESS_TOKEN=change-me

# Forward WebSocket alternative (JSON array); also set
# DRIVER=~fastapi+~websockets:
# ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3001"]
# HTTP API alternative (JSON object keyed by bot self_id); also set
# DRIVER=~fastapi+~httpx:
# ONEBOT_V11_API_ROOTS={"123456789":"http://127.0.0.1:5700"}

# Optional error reporting. Leave empty to disable Sentry reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=yawnbot@0.1.0
SENTRY_SAMPLE_RATE=1.0
SENTRY_DEBUG=false

# Optional OpenAI-compatible service. Without a key the bot still starts:
# private AI chat is unavailable, werewolf AI uses safe fallback behavior,
# and RPG can run deterministically with RPG_AI_ENABLED=false.
AI_API_KEY=
AI_BASE_URL=https://your-openai-compatible-endpoint/v1
AI_MODEL=your-model
AI_MAX_TOKENS=1024
# Agent role models. Blank role values fall back to AI_MODEL.
# AGENT_DIALOGUE_MODEL=your-advanced-agent-model
# AGENT_MEMORY_MODEL=your-cheap-memory-model
# AGENT_VISION_MODEL=your-image-model
# AGENT_DIALOGUE_MULTIMODAL=auto
# AGENT_MEDIA_CACHE_TTL=86400
# AGENT_MEDIA_CACHE_DIR=data/agent_media
# AGENT_MEDIA_ALLOWED_HOSTS=
RPG_AI_ENABLED=false
WW_AI_ENABLED=false

# Optional global defaults for the group Agent persona. A group admin can
# override individual fields with /Agent人设 设置; leave blank for defaults.
# AGENT_PERSONA_NAME=Yawn
# AGENT_PERSONA_IDENTITY=友好、自然、简洁的群友
# AGENT_PERSONA_ROLE=群聊助手
# AGENT_PERSONA_TONE=口语化、温和、不过度热情
# AGENT_PERSONA_SPEECH_STYLE=短句为主，偶尔使用轻松语气词
# AGENT_PERSONA_VALUES=尊重事实、尊重边界、先倾听再回答
# AGENT_PERSONA_KNOWLEDGE_BOUNDARY=不知道就明确说不知道，不猜测成员隐私
# AGENT_PERSONA_EMOTION_BASELINE=平静、友善，随对话轻微变化
# AGENT_PERSONA_RESPONSE_LENGTH=通常 1-3 句，复杂问题再展开
# AGENT_PERSONA_PRIVACY_BOUNDARY=不公开私聊内容、隐私记忆、权限信息和工具内部结果
# AGENT_FILE_ROOT=data/agent_files
# AGENT_FILE_ALLOWED_HOSTS=

# Optional Fanqie novel downloader. It never logs in or requests paid chapters.
# FANQIE_REQUEST_TIMEOUT=30
# FANQIE_REQUEST_RETRIES=2
# FANQIE_REQUEST_DELAY=0.5
# FANQIE_QUEUE_MAX=20
# FANQIE_USER_ACTIVE_MAX=1
# FANQIE_GROUP_ACTIVE_MAX=3
# FANQIE_MAX_CHAPTERS=500
# FANQIE_MAX_FILE_BYTES=33554432
# FANQIE_FILE_RETENTION_HOURS=24
# FANQIE_RANK_LIMIT=10
# Search uses a dedicated persistent Playwright Chromium profile so the public
# page can keep its own security SDK session. Leave blank for localstore data.
# FANQIE_BROWSER_TIMEOUT=30
# FANQIE_BROWSER_HEADLESS=true
# FANQIE_BROWSER_PROFILE_DIR=
# The fixed Reading 7.2.1 App protocol is tried before external full-text mirrors.
# FANQIE_APP_PROTOCOL_ENABLED=true
# Default third-party API used only for chapters explicitly marked free by the reader page.
# FANQIE_THIRD_PARTY_API_BASE=http://101.35.133.34:5000
# FANQIE_THIRD_PARTY_API_TIMEOUT=30
# FANQIE_THIRD_PARTY_API_RETRIES=1
# The fallback public App-content proxy is used after the raw_full node fails.
# Its frontend token is bundled as a default and can be replaced when rotated.
# FANQIE_THIRD_PARTY_FALLBACK_BASE=https://api.fanqietc.com
# FANQIE_THIRD_PARTY_FALLBACK_TOKEN=
# To fill a free chapter when its public reader page contains only a preview, point to a
# separately installed compatible local Tomato Novel Downloader executable. The helper
# starts per chapter on 127.0.0.1 with a temporary data/output directory.
# FANQIE_MOBILE_HELPER_PATH=
# FANQIE_MOBILE_HELPER_STARTUP_TIMEOUT=15
# FANQIE_MOBILE_HELPER_TIMEOUT=120

# Common gameplay overrides; see each config.py for the complete list.
# RPG_MIN_PLAYERS=1
# RPG_MAX_PLAYERS=6
# RPG_SIGNUP_TIMEOUT=120
# WW_MIN_PLAYERS=9
# WW_MAX_PLAYERS=12
# WW_SIGNUP_TIMEOUT=180
