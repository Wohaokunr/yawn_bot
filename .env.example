# YawnBot 环境变量示例
#
# 使用方式：
# 1. 将本文件复制为项目根目录下的 .env（或 .env.<ENVIRONMENT>）。
# 2. 只修改确实需要覆盖的值；空值通常表示“关闭可选功能”或“使用代码默认值”。
# 3. JSON 类型的变量必须保持合法 JSON，例如数组使用 ["123456789"]，对象使用 {"key":"value"}。
# 4. .env 可能包含密钥、Cookie 或内部地址，禁止提交真实配置；生产环境请使用密钥管理服务。
# 5. NoneBot 会先读取 ENVIRONMENT，再合并 .env.<ENVIRONMENT>；显式的系统环境变量优先级最高。
#
# 下方给出的是可直接运行的本地示例。部署到公网或反向代理后，请重新检查
# OneBot 令牌、WebUI 管理令牌、Cookie Secure 和外部服务访问白名单。

# ── NoneBot 运行时 ─────────────────────────────────────────────────────────────

# 运行环境名称。常用值为 prod、dev、test；它决定是否加载对应的 .env.<名称> 文件。
ENVIRONMENT=prod

# NoneBot 驱动器。~fastapi 提供 HTTP/WebSocket 服务；如果启用正向 WebSocket 或
# HTTP API 连接，还要把对应的 ~websockets 或 ~httpx 追加到此处，详见下方 OneBot 配置。
DRIVER=~fastapi

# FastAPI 监听地址和端口。仅本机访问可使用 127.0.0.1；由反向代理统一接入时也建议
# 只监听回环地址。若直接对外监听，请同时配置防火墙和 HTTPS 入口。
HOST=127.0.0.1
PORT=8080

# 日志级别：TRACE、DEBUG、INFO、WARNING、ERROR、CRITICAL。生产环境通常使用 INFO，
# 排查问题时临时改为 DEBUG，问题结束后再恢复，避免日志过多。
LOG_LEVEL=INFO

# OneBot 超级用户列表，必须是 JSON 字符串数组。列表中的 QQ 号用于执行高权限命令；
# QQ 号按字符串保存，避免被 JSON/JavaScript 当作数字而丢失精度。
SUPERUSERS=["123456789"]

# NoneBot 会话状态的过期时间，格式为 HH:MM:SS。示例为 2 分钟；调大可以减少多轮命令
# 中断，但也会让未完成会话占用状态更久。
SESSION_EXPIRE_TIMEOUT=00:02:00

# ── 本地数据与 SQLite/ORM ──────────────────────────────────────────────────────

# 是否把 localstore 的数据目录固定在当前工作目录。true 时数据库、缓存等默认落在 ./data；
# 容器或 systemd 部署请确保该目录持久化，并给运行用户写权限。
LOCALSTORE_USE_CWD=true

# SQLAlchemy 引擎选项，值为 JSON 对象。这里把 SQLite 忙等待时间设为 30 秒，
# 可以降低短暂写锁冲突；不要直接编辑 SQLite 文件，ORM 迁移请由维护者备份后执行。
SQLALCHEMY_ENGINE_OPTIONS={"connect_args":{"timeout":30}}

# Alembic/nonebot_plugin_orm 的上下文选项。compare_server_default=true 让迁移比较服务器
# 默认值；修改此项前请确认对应迁移脚本和现有数据库状态。
ALEMBIC_CONTEXT={"compare_server_default":true}

# ── OneBot V11 连接 ─────────────────────────────────────────────────────────────

# 三种连接方式请选择一种，不要同时配置多个未知来源的入口。所有 token 都应替换为随机、
# 不与 WebUI_ADMIN_TOKEN 共用的值。
#
# 方式 A：反向 WebSocket（推荐用于 Bot 主动连接本进程）
# OneBot 实现连接 ws://HOST:PORT/onebot/v11/ws，并在连接端填写同一个 access token。
ONEBOT_V11_ACCESS_TOKEN=change-me
#
# 方式 B：正向 WebSocket（本进程主动连接 OneBot 实现）
# ONEBOT_V11_WS_URLS 必须是 JSON 字符串数组；同时把 DRIVER 改为：
# DRIVER=~fastapi+~websockets
# ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3001"]
#
# 方式 C：HTTP API（本进程按 bot self_id 选择 API 根地址）
# ONEBOT_V11_API_ROOTS 必须是 JSON 对象，键为 Bot 的 self_id；同时把 DRIVER 改为：
# DRIVER=~fastapi+~httpx
# ONEBOT_V11_API_ROOTS={"123456789":"http://127.0.0.1:5700"}
#
# 使用 HTTPS/WSS 时请把示例地址替换为 https:// 或 wss://，并在反向代理中正确转发
# Upgrade、Host 和 Authorization 相关请求头。

# ── Sentry 可选错误上报 ─────────────────────────────────────────────────────────

# 留空表示关闭 Sentry。启用时只填写 DSN，不要把 DSN 当作 OneBot 或 WebUI 管理令牌。
SENTRY_DSN=

# Sentry 环境标签，用于区分生产、预发布和测试项目。
SENTRY_ENVIRONMENT=production

# 发布版本标签，建议随应用版本更新，便于关联堆栈和回滚。
SENTRY_RELEASE=yawnbot@0.1.0

# 采样率，范围 0.0 到 1.0。1.0 表示全部采集；生产环境可按流量和隐私要求降低。
SENTRY_SAMPLE_RATE=1.0

# 是否开启 Sentry SDK 调试日志。通常保持 false，排查上报问题时临时设为 true。
SENTRY_DEBUG=false

# ── OpenAI-compatible 服务 ─────────────────────────────────────────────────────

# AI_API_KEY 为空时 Bot 仍可启动：私聊 AI 对话不可用，狼人杀使用安全回退行为，
# RPG 可以通过 RPG_AI_ENABLED=false 运行确定性流程。不要把真实密钥提交到仓库。
AI_API_KEY=

# OpenAI-compatible API 根地址，通常需要包含 /v1；也可以填写内部网关地址。
AI_BASE_URL=https://your-openai-compatible-endpoint/v1

# 内置 default 提供商继续使用上面的 AI_BASE_URL / AI_API_KEY。需要多个端点时，
# 在 AI_PROVIDERS 中添加命名提供商，并在 AI_PROVIDER_API_KEYS 中按 ID 配置密钥。
# ID 只能使用小写字母、数字、下划线和连字符，且不能使用保留 ID default。
# WebUI 会完整隐藏 AI_PROVIDER_API_KEYS，不会回显其中任何密钥。
# AI_PROVIDERS=[{"id":"fast","base_url":"https://fast.example.com/v1"}]
# AI_PROVIDER_API_KEYS={"fast":"replace-with-real-key"}

# 默认模型名称：复杂对话、跑团 KP 和狼人杀决策默认使用此档位。
AI_MODEL=your-model

# 轻量模型用于简单且频繁的结构化/短文本任务；留空时回退到 AI_MODEL。
# 识图模型只在图片任务或当前任务模型不支持图片时使用；留空时无法进行独立识图降级。
# AI_LIGHT_MODEL=your-light-model
# AI_VISION_MODEL=your-vision-model

# 三个模型档位绑定的提供商 ID。轻量模型留空时会完整继承默认档位的提供商和模型；
# 识图模型留空时仍视为没有独立识图能力。
AI_DEFAULT_PROVIDER=default
AI_LIGHT_PROVIDER=default
AI_VISION_PROVIDER=default

# 三个模型档位的全局推理策略：auto 不发送厂商参数，enabled/disabled 会发送
# extra_body.thinking.type。轻量和识图任务默认关闭推理以降低延迟与费用。
AI_DEFAULT_THINKING=auto
AI_LIGHT_THINKING=disabled
AI_VISION_THINKING=disabled

# 默认/轻量模型的图片能力：auto 先尝试并在明确不支持时降级；supported 直接发送；
# unsupported 不发送图片，直接交给识图任务生成文字描述。
AI_DEFAULT_MULTIMODAL=auto
AI_LIGHT_MULTIMODAL=auto

# 单次补全允许的最大输出 token 数。过小会截断回答，过大则会增加成本和延迟。
AI_MAX_TOKENS=1024

# ── Core / Agent 管理 WebUI ────────────────────────────────────────────────────

# WebUI 与 NoneBot 共用同一个 FastAPI 进程，访问路径为 /webui。默认关闭，避免在
# 未配置管理令牌时暴露管理端；启用后还必须先构建 webui/ 前端产物（npm ci && npm run build）。
WEBUI_ENABLED=false

# 运维管理员登录令牌。启用 WebUI 时必填且至少 32 个字符，建议使用密码管理器生成的
# 高熵随机字符串；不要复用 OneBot token、AI_API_KEY 或其他系统密码。
WEBUI_ADMIN_TOKEN=

# 登录后签名会话 Cookie 的有效时长，单位为小时。过期后需要重新登录。
WEBUI_SESSION_TTL_HOURS=12

# HTTPS 部署时设为 true，使浏览器只通过 HTTPS 发送会话 Cookie；本地 HTTP 调试保持 false。
# 如果反向代理已经终止 TLS，仍应按浏览器实际访问协议设置为 true。
WEBUI_COOKIE_SECURE=false

# ── 子插件 LLM 任务路由、Agent 媒体和文件工具 ───────────────────────────────────

# 子插件任务路由。PROFILE 可选 default/light/vision；THINKING 可选
# inherit/auto/enabled/disabled，inherit 表示沿用所选模型档位的全局推理策略。
AGENT_DIALOGUE_LLM_PROFILE=default
AGENT_DIALOGUE_THINKING=inherit
AGENT_PROACTIVE_LLM_PROFILE=light
AGENT_PROACTIVE_THINKING=inherit
AGENT_MEMORY_LLM_PROFILE=light
AGENT_MEMORY_THINKING=inherit
AGENT_IMAGE_LLM_PROFILE=vision
AGENT_IMAGE_THINKING=inherit

RPG_KP_LLM_PROFILE=default
RPG_KP_THINKING=inherit
RPG_NPC_ROUTER_LLM_PROFILE=light
RPG_NPC_ROUTER_THINKING=inherit
RPG_NPC_LLM_PROFILE=light
RPG_NPC_THINKING=inherit

WW_DECISION_LLM_PROFILE=default
WW_DECISION_THINKING=inherit
WW_SPEECH_LLM_PROFILE=light
WW_SPEECH_THINKING=inherit

# 媒体缓存保留秒数、目录和允许的来源主机。目录应位于持久化数据盘；白名单建议填写
# 明确需要访问的域名（逗号分隔），不要为了省事放开任意外部主机。
# 注意：白名单留空时群图片无法下载，视觉理解会静默失效；QQ 图片常见域名示例如下。
# AGENT_MEDIA_CACHE_TTL=86400
# AGENT_MEDIA_CACHE_DIR=data/agent_media
# AGENT_MEDIA_ALLOWED_HOSTS=gchat.qpic.cn,multimedia.nt.qq.com.cn

# Agent 的本地文件工具根目录和允许访问的远程主机。根目录应使用独立目录，避免指向
# 项目源码、数据库或系统目录；远程主机白名单为空时不主动下载外部文件。
# AGENT_FILE_ROOT=data/agent_files
# AGENT_FILE_ALLOWED_HOSTS=

# Agent 子插件海量调试日志开关。true 开启后输出完整处理链路日志（以 INFO 级别输出、
# 前缀 [agent-debug]，因此无需同时调整 LOG_LEVEL）。注意：开启后日志会包含完整群消息
# 内容和 LLM 回复，仅供本地排查使用，不要在生产长期开启。
AGENT_DEBUG_LOG=false

# ── Core/Agent AI 开关 ───────────────────────────────────────────────────────────

# RPG 是否启用 AI 叙事/工具流程。false 为确定性模式，适合无 AI key 或回归测试。
RPG_AI_ENABLED=false

# 狼人杀是否启用 AI 玩家。未配置 AI_API_KEY 时建议保持 false，以使用可预测的回退逻辑。
WW_AI_ENABLED=false

# ── Agent 全局默认人设 ──────────────────────────────────────────────────────────

# 这些是所有群组的全局默认值。群主/管理员可通过群内命令或 WebUI 对单个字段设置群覆盖；
# 群覆盖为空或被重置时会重新继承这里的值。每个字段沿用现有 240 字符限制，建议写成
# 简洁、稳定、不会泄露隐私的行为约束。
# AGENT_PERSONA_NAME=Yawn
# AGENT_PERSONA_IDENTITY=友好、自然、简洁的群友
# AGENT_PERSONA_ROLE=群聊助手
# AGENT_PERSONA_TONE=口语化、温和、不过度热情
# AGENT_PERSONA_SPEECH_STYLE=短句为主，偶尔使用轻松语气词
# AGENT_PERSONA_VALUES=尊重事实、尊重边界、先倾听再回答
# AGENT_PERSONA_KNOWLEDGE_BOUNDARY=不知道就明确说不知道，不猜测成员隐私
# AGENT_PERSONA_EMOTION_BASELINE=平静、友善，随对话轻微变化
# AGENT_PERSONA_RESPONSE_LENGTH=通常 1-3 句，复杂问题再展开
# AGENT_PERSONA_PRIVACY_BOUNDARY=不公开私聊内容、隐私记忆、权限信息和工具内部结果

# ── 番茄小说插件（可选） ───────────────────────────────────────────────────────

# 插件只访问公开页面或明确标记为免费的章节，不登录、不请求付费章节。以下参数用于
# 限制请求并发、文件大小和保留时间；值越大不代表更快，过度调高可能触发上游限流。
# FANQIE_REQUEST_TIMEOUT=30
# FANQIE_REQUEST_RETRIES=2
# FANQIE_REQUEST_DELAY=0.5
# FANQIE_QUEUE_MAX=20
# FANQIE_USER_ACTIVE_MAX=1
# FANQIE_GROUP_ACTIVE_MAX=3
# FANQIE_MAX_CHAPTERS=500
# FANQIE_MAX_FILE_BYTES=33554432
# FANQIE_FILE_RETENTION_HOURS=24
# FANQIE_RANK_LIMIT=10

# 搜索使用独立的持久化 Playwright Chromium profile，以保存公开页面所需的安全 SDK 会话。
# 留空 FANQIE_BROWSER_PROFILE_DIR 时使用 localstore 下的默认目录；服务器无图形界面时保持
# headless=true。浏览器 profile 只放该插件的会话数据，不要与个人浏览器复用。
# FANQIE_BROWSER_TIMEOUT=30
# FANQIE_BROWSER_HEADLESS=true
# FANQIE_BROWSER_PROFILE_DIR=

# 官方 Reading 7.2.1 App 协议来源会优先于外部全文镜像；设为 false 可完全禁用该来源。
# FANQIE_APP_PROTOCOL_ENABLED=true

# 仅当阅读页明确标记章节免费时才使用的第三方 API。它属于外部依赖，建议通过网络策略限制
# 出站范围，并在服务不可用时保留可重试任务。
# FANQIE_THIRD_PARTY_API_BASE=http://101.35.133.34:5000
# FANQIE_THIRD_PARTY_API_TIMEOUT=30
# FANQIE_THIRD_PARTY_API_RETRIES=1

# raw_full 节点失败后使用的公开 App 内容代理。代理前端 token 由上游轮换时再覆盖；
# 该 token 不是 NoneBot 或 WebUI token，不要写入公开仓库。
# FANQIE_THIRD_PARTY_FALLBACK_BASE=https://api.fanqietc.com
# FANQIE_THIRD_PARTY_FALLBACK_TOKEN=

# 当公开阅读页只有截断预览、且章节明确免费时，可指定已单独安装的兼容 Tomato Novel
# Downloader 可执行文件。helper 每章在 127.0.0.1 启动，并使用临时 data/output 目录；
# 只填写本机绝对路径，不要指向不可信的远程程序。
# FANQIE_MOBILE_HELPER_PATH=
# FANQIE_MOBILE_HELPER_STARTUP_TIMEOUT=15
# FANQIE_MOBILE_HELPER_TIMEOUT=120

# ── 游戏插件常用覆盖 ───────────────────────────────────────────────────────────

# 以下只是常用示例；完整参数、默认值和边界以各插件的 config.py/CLAUDE.md 为准。
# 调整玩家数和报名超时前，请确认群组人数与 AI 补位策略相容。
# RPG_MIN_PLAYERS=1
# RPG_MAX_PLAYERS=6
# RPG_SIGNUP_TIMEOUT=120
# WW_MIN_PLAYERS=9
# WW_MAX_PLAYERS=12
# WW_SIGNUP_TIMEOUT=180

# ── 维护提示 ───────────────────────────────────────────────────────────────────

# ORM 表结构升级前先备份 data/ 下的 SQLite 数据库；升级由维护者手动执行：
# uv run nb orm upgrade heads
# 正式部署建议把 .env、数据库备份、浏览器 profile 和媒体缓存放在受控目录，
# 并通过反向代理启用 HTTPS、WebUI_COOKIE_SECURE=true 和访问日志脱敏。
