# YawnBot repository hygiene
#
# The repository stores source code, reproducible configuration examples and fixed
# assets. Generated output, runtime state and developer-tool private state stay local.

# Secrets and local environment overrides
.env
.env.*
!.env.example
*.pem
*.key

# Python / uv / test / type-check caches
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
ENV/
__pypackages__/
.uv-cache*/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.eggs/
/build/
/dist/
/site/

# Node / Vite / TypeScript / Playwright generated output
**/node_modules/
/webui/dist/
/webui/.vite/
*.tsbuildinfo
.playwright/
playwright-report/
test-results/
.cache/ms-playwright/
ms-playwright/

# Runtime databases, backups, logs and transient files
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
*-wal
*-shm
*.log
*.pid
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
/.tmp_*
/tmp/
/temp/
/.local-db-backups/

# Runtime data is not source. Keep only canonical ORM migration scripts.
/data/*
!/data/nonebot_plugin_orm/
/data/nonebot_plugin_orm/*
!/data/nonebot_plugin_orm/migrations/
!/data/nonebot_plugin_orm/migrations/**

# IDE / coding-agent / developer private state
**/.qoder/
**/.zcode/
**/.claude/
**/.mimosa/
**/.vs/
**/.vscode/
**/.idea/

# Windows / OS caches accidentally created under the repository root
/%SystemDrive%/
/System Volume Information/
/$RECYCLE.BIN/
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
ehthumbs.db

# Misc generated artifacts
.ipynb_checkpoints/
docs/_build/
doc/_build/
target/
downloads/

# Re-apply generated-file rules after the migration allowlist above. Git's later
# negation can otherwise make caches nested under the tracked migration tree visible.
**/__pycache__/
**/*.pyc
**/.mimosa/
